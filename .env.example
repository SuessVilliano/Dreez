# Comma-separated trusted management emails. Uses Sites Sign in with ChatGPT.
ADMIN_EMAILS=

# Public canonical URL used by SEO metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=
# Optional OpenAI-powered concierge. Without this, the concierge uses its built-in Dreez fallback knowledge.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Optional embeddable livestream player URL for /live (YouTube/Twitch/etc. embed URL, not a normal watch page).
DREEZ_LIVE_EMBED_URL=
DREEZ_LIVE_TITLE=Dreez Live Room
